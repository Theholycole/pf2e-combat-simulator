{
  "id": "pf2e-combat-simulator",
  "title": "PF2e Combat Simulator",
  "description": "Plays PF2e encounters in memory many times and reports the odds: win rate, objective success, PC danger and morale. A balance tester for GMs, with an in-play odds check.",
  "version": "0.19.1",
  "url": "https://github.com/Theholycole/pf2e-combat-simulator",
  "manifest": "https://github.com/Theholycole/pf2e-combat-simulator/releases/latest/download/module.json",
  "download": "https://github.com/Theholycole/pf2e-combat-simulator/releases/download/v0.19.1/module.zip",
  "readme": "https://github.com/Theholycole/pf2e-combat-simulator#readme",
  "bugs": "https://github.com/Theholycole/pf2e-combat-simulator/issues",
  "license": "LICENSE",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "TheHolyCole"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.5.0",
          "verified": "8.6.1"
        }
      }
    ],
    "requires": [
      {
        "id": "pf2e-resolution-core",
        "type": "module",
        "reason": "Spells and abilities are resolved by the core's families; the simulator's engine imports the core's pure code.",
        "manifest": "https://github.com/Theholycole/PF2e-Automation-Core/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "0.7.4"
        }
      }
    ],
    "recommends": [
      {
        "id": "pf2e-automatic-ability-resolution",
        "type": "module",
        "manifest": "https://github.com/Theholycole/pf2e-automatic-ability-resolution/releases/latest/download/module.json",
        "reason": "Monster abilities, PC feat actions and basic actions in the simulated fights come from its compiler.",
        "compatibility": {
          "minimum": "0.9.0"
        }
      },
      {
        "id": "pf2e-automatic-resolution",
        "type": "module",
        "manifest": "https://github.com/Theholycole/pf2e-automatic-spell-resolution/releases/latest/download/module.json",
        "reason": "Spells in the simulated fights come from its compiler."
      },
      {
        "id": "pf2e-automatic-item-resolution",
        "type": "module",
        "manifest": "https://github.com/Theholycole/pf2e-automatic-item-resolution/releases/latest/download/module.json",
        "reason": "Consumables in the simulated fights (potions, elixirs, bombs, talismans) come from its compiler.",
        "compatibility": {
          "minimum": "0.12.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/simulator.css"
  ]
}
